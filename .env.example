# Copy this file to .env for local dev / running scripts/seed.mjs.
# In production, set these as Netlify environment variables instead
# (Site configuration -> Environment variables) — never commit real values.

# Supabase (Project Settings -> Data API for URL, -> API Keys for the secret key)
SUPABASE_URL=https://idlmmvmxbdebpurovkee.supabase.co
SUPABASE_SECRET_KEY=replace-with-your-sb_secret_-key
SUPABASE_PRODUCT_BUCKET=product-images
SUPABASE_CUSTOM_CAKE_BUCKET=custom-cakes

# Auth
JWT_SECRET_KEY=replace-with-a-long-random-value
ADMIN_USERNAME=admin
ADMIN_PASSWORD=########

# CORS - comma separated list of allowed frontend origins in production.
# Leave blank for local dev (any origin allowed) or if frontend+backend
# are served from the same Netlify site (recommended, same-origin, no CORS needed).
FRONTEND_URL=

# Frontend build (Vite). Leave unset in production — api.js already
# defaults to same-origin "/api", which Netlify redirects to the function.
VITE_API_URL=

# Security mode: "normal" for production. Never set to "research" in production —
# it intentionally weakens coupon-stacking validation for demo/testing purposes.
CAKELY_SECURITY_MODE=normal

# RuleLock AI integration point — disabled by default so Cakely works standalone.
RULELOCK_ENABLED=false
RULELOCK_API_URL=
RULELOCK_API_KEY=
RULELOCK_TIMEOUT=5
RULELOCK_FAIL_MODE=OPEN
